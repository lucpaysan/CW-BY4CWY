{
  "name": "CW-BY4CWY",
  "private": true,
  "version": "2.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "npm run test:deepcw && npm run test:reseg && npm run test:wpm && npm run test:wpm-rolling && npm run test:wpm-worker && npm run test:dsp && npm run test:arb",
    "test:deepcw": "esbuild src/deepcw/__tests__/selfCheck.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/deepcw-selfcheck.mjs --log-level=error && node node_modules/.cache/deepcw-selfcheck.mjs",
    "test:reseg": "esbuild src/deepcw/__tests__/resegCheck.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/deepcw-reseg.mjs --log-level=error && node node_modules/.cache/deepcw-reseg.mjs",
    "test:wpm": "esbuild src/deepcw/__tests__/wpmCheck.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/deepcw-wpm.mjs --log-level=error && node node_modules/.cache/deepcw-wpm.mjs",
    "test:deepcw:e2e": "esbuild src/deepcw/__tests__/e2eExport.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/deepcw-e2e-export.mjs --log-level=error && node node_modules/.cache/deepcw-e2e-export.mjs /tmp/deepcw_e2e",
    "test:arb": "esbuild src/engines/__tests__/arbitrationCheck.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/engine-arb.mjs --log-level=error && node node_modules/.cache/engine-arb.mjs",
    "test:wpm-rolling": "esbuild src/deepcw/__tests__/wpmRollingCheck.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/deepcw-wpm-rolling.mjs --log-level=error && node node_modules/.cache/deepcw-wpm-rolling.mjs",
    "test:wpm-worker": "esbuild src/deepcw/__tests__/crossAuditWorkerPattern.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/deepcw-wpm-worker.mjs --log-level=error && node node_modules/.cache/deepcw-wpm-worker.mjs",
    "test:dsp": "esbuild src/ggmorse/__tests__/dspCheck.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ggmorse-dsp.mjs --log-level=error && node node_modules/.cache/ggmorse-dsp.mjs"
  },
  "dependencies": {
    "@mantine/core": "^8.2.7",
    "@mantine/hooks": "^8.2.7",
    "onnxruntime-web": "1.20.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@tauri-apps/cli": "^2.10.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "png-to-icns": "^1.0.0",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vite-plugin-singlefile": "^2.3.2"
  },
  "description": "CW 通联辅助工具 —— 把电波中的 Morse 信号实时转成文字",
  "license": "AGPL-3.0"
}
